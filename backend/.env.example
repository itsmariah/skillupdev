# O servidor valida estas variáveis ao iniciar: valores inválidos impedem a subida e
# configurações faltando aparecem como aviso no log. Em produção (NODE_ENV=production ou
# no Render), DATABASE_URL e APP_BASE_URL (com https) são obrigatórias.

PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

EMAIL_PROVIDER=resend
EMAIL_FROM=SkillUp Dev <no-reply@seu-dominio.com>
EMAIL_REPLY_TO=voce@seu-dominio.com
RESEND_API_KEY=sua_chave_resend_aqui

# Só para desenvolvimento local sem e-mail configurado: devolve o link de reset na
# própria resposta da API. Ignorado quando NODE_ENV=production. Nunca ative em produção.
ALLOW_RESET_PREVIEW=false

# Estudo piloto do TCC (convite, questionários pré e pós). Encerrado: deixe false.
# Com true, os questionários voltam para a jornada. Os dados antigos ficam no painel admin.
STUDY_ENABLED=false

# Fuso que define a virada do dia no bônus de acesso diário (padrão: America/Sao_Paulo).
APP_TIMEZONE=America/Sao_Paulo

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Banco de dados: PostgreSQL (Neon em produção). Use a connection string do painel do Neon,
# com ?sslmode=require. Se deixar em branco, o desenvolvimento local usa o PGlite
# (Postgres embutido, gravado em backend/data/pglite). Em produção é obrigatória.
DATABASE_URL=

# Banco antigo (Upstash Redis): usado só pelo script de backup (npm run backup)
# para levar os dados ao PostgreSQL. Pode ser removido depois da virada.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Credenciais do administrador (criadas automaticamente no primeiro start)
ADMIN_EMAIL=admin@skillupdev.com
ADMIN_PASSWORD=escolha_uma_senha_forte_aqui
