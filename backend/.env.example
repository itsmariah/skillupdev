PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

EMAIL_PROVIDER=resend
EMAIL_FROM=SkillUp Dev <no-reply@seu-dominio.com>
EMAIL_REPLY_TO=voce@seu-dominio.com
RESEND_API_KEY=sua_chave_resend_aqui

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Banco de dados (Upstash Redis). Se deixar em branco, usa arquivo local
# (backend/data/db.json) — ok para dev, mas não persiste em hosts sem disco.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Credenciais do administrador (criadas automaticamente no primeiro start)
ADMIN_EMAIL=admin@skillupdev.com
ADMIN_PASSWORD=escolha_uma_senha_forte_aqui
